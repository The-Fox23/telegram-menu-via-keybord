on:
  push:
  pull_request:

jobs:
  json:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate JSON
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          for p in Path(".").rglob("*.json"):
              json.loads(p.read_text(encoding="utf-8"))
              print("OK", p)
          PY
